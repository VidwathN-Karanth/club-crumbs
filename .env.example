# ============================================================================
#  Club Crumbs — environment variables
#  Copy this file to .env.local and fill in the values:  cp .env.example .env.local
#  .env.local is gitignored, so your real keys never get committed.
# ============================================================================

# ── Clerk (authentication) ─────────────────────────────────────────────────
# REQUIRED — the app will not even start without these.
# Get them from https://dashboard.clerk.com → your app → API Keys.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxx

# ── Supabase (database) ─────────────────────────────────────────────────────
# Needed for real cloud sync. If left blank the app runs in "Local Demo Mode"
# (data lives only in the browser and resets on refresh).
# Get these from https://supabase.com/dashboard → your project → Project Settings → API.
#
# Server-side (never exposed to the browser): the Project URL + the SERVICE ROLE key.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
# Client-side (safe to expose): the same Project URL + the ANON/public key.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# ── GitHub (leaderboard) ────────────────────────────────────────────────────
# OPTIONAL. Used to read public GitHub contribution counts for the leaderboard.
# A classic token with NO scopes (public data only) is enough.
# Create at https://github.com/settings/tokens
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx

# ── Nightly sync (cron) ─────────────────────────────────────────────────────
# OPTIONAL for local dev. In production this secret guards /api/cron/daily-sync
# so only your scheduler (e.g. Vercel Cron) can trigger the 10 PM leaderboard sync.
# Use any long random string.
CRON_SECRET=

# ── Optional extras ─────────────────────────────────────────────────────────
# Google Search Console verification meta tag (SEO only).
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# Links the "install the extension" buttons point at (leave blank if unused).
NEXT_PUBLIC_EXTENSION_AMO_URL=
NEXT_PUBLIC_EXTENSION_STORE_URL=

# ── Code judge (the "Coding" feature) ───────────────────────────────────────
# The Judge0 instance that runs student code. See docs/JUDGE0_SETUP.md for a
# free, self-hosted Oracle Cloud setup. Run and Submit are disabled until this
# is set. JUDGE0_AUTH_TOKEN is the X-Auth-Token that instance expects.
JUDGE0_URL=
JUDGE0_AUTH_TOKEN=

# ── Dev server ──────────────────────────────────────────────────────────────
# The local dev server port. `npm run dev` will use this (default Next.js is 3000).
PORT=4000
